---
import "../styles/global.css";
import { SITE_TITLE, BASE } from "../consts";
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href={`${BASE}/sitemap-index.xml`} />
  </head>
  <body>
    <header>
      <a class="brand" href={`${BASE}/`}>{SITE_TITLE}</a>
      <nav><a href={`${BASE}/`}>Home</a><a href={`${BASE}/about/`}>About</a><a href={`${BASE}/blog/`}>Blog</a></nav>
    </header>
    <main><slot /></main>
    <footer>© {new Date().getFullYear()} {SITE_TITLE}</footer>
  </body>
</html>
