---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_TITLE } from "../consts";
---
<BaseLayout title={`About ${SITE_TITLE}`} description="About us">
  <h1>About us</h1>
  <p>We started in 2020 with a five-kilo roaster in a garage. Every bag names the farm, the altitude and the process.</p>
  <p>Our roasts are light to medium: we want you to taste where the coffee comes from, not the roast.</p>
</BaseLayout>
